# Optional: Anthropic API key (https://console.anthropic.com). Without it the app runs in free demo mode.
ANTHROPIC_API_KEY=

# MongoDB connection string, e.g. from Atlas: Connect -> Drivers
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority

# Optional: database name (default: mini_support_inbox)
# MONGODB_DB=mini_support_inbox

# Optional: Claude model override (default: claude-opus-5-5)
# ANTHROPIC_MODEL=
